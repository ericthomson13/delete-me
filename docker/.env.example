# Copy to docker/.env and edit. The .env file is gitignored.
# At minimum, set POSTGRES_PASSWORD to a strong random value.

# Postgres
POSTGRES_PASSWORD=changeme-please

# Service
SERVICE_PORT=8080
DELETE_ME_LOG_LEVEL=INFO
# Comma-separated list of allowed origins for CORS.
DELETE_ME_CORS_ORIGINS=http://localhost:8080,tauri://localhost

# Postmark — leave blank to keep ALL sends in dry-run mode.
# Get a token at https://account.postmarkapp.com/servers
POSTMARK_SERVER_TOKEN=
DELETE_ME_FROM_ADDRESS=delete-me-agent@your-verified-domain.example
